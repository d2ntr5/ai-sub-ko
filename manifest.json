{
  "manifest_version": 3,
  "name": "AI 자막 번역 (ai-sub-ko)",
  "version": "1.0.21",
  "description": "F1 TV·YouTube·강의 영상의 영어 자막을, 자막이 없으면 소리를 맥 안에서 받아 적어(영어·일본어) Claude·Gemini·크롬 내장 번역으로 한국어 자막으로 보여 준다 (macOS 전용)",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "scripting",
    "tabCapture",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://f1tv.formula1.com/*",
    "https://*.formula1.com/*",
    "https://www.youtube.com/*",
    "https://skillbuilder.aws/*",
    "https://*.skillbuilder.aws/*",
    "https://anthropic.skilljar.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI 자막 번역",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://f1tv.formula1.com/*",
        "https://*.formula1.com/*",
        "https://www.youtube.com/*",
        "https://skillbuilder.aws/*",
        "https://*.skillbuilder.aws/*",
        "https://anthropic.skilljar.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "yt-main.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],
  "commands": {
    "listen-toggle": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "음성 번역 시작 · 멈추기"
    }
  }
}
